# Django Settings
DJANGO_SECRET_KEY=your_django_secret_key_here
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration
# Leave blank to use default local SQLite db.sqlite3, or provide database URL
# DATABASE_URL=postgres://user:password@localhost:5432/dbname

# reCAPTCHA Keys (Get real keys from https://www.google.com/recaptcha/admin)
RECAPTCHA_PUBLIC_KEY=your_recaptcha_site_key
RECAPTCHA_PRIVATE_KEY=your_recaptcha_secret_key

# Email / Contact Form Configuration
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password
ADMIN_EMAIL=your_admin_email_for_notifications@gmail.com

# CORS Configuration
# CORS_ALLOWED_ORIGINS=http://localhost:3000,https://yourportfolio.com
